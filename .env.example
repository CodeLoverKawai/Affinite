# Database Credentials
DB_USER=affine_user
DB_PASSWORD=affine_pass
DB_NAME=affine_db

# Local Host Bindings and Volume Paths
# (Change these to your target directories)
DB_DATA_VOLUME=./data/db
AFFINE_STORAGE_VOLUME=./data/storage
AFFINE_CONFIG_VOLUME=./data/config

# Port and External Access URL
# (Set AFFINE_PORT_BINDING to "5320" to bind to all interfaces, or keep "127.0.0.1:5320" behind a reverse proxy)
AFFINE_PORT_BINDING=127.0.0.1:5320
AFFINE_EXTERNAL_URL=http://localhost:5320

# Ollama local AI connection (Defaults to Docker host gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama
